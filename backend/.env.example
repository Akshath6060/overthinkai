APP_ENV=development
APP_NAME=Overthinker AI
MONGODB_URI=memory://
MONGODB_DATABASE=overthinker
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_CREDIT_ALLOWANCE=1000
AI_PROVIDER=mock
LOG_LEVEL=INFO
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DOCS_ENABLED=true
