# Frontend (configure in the overthinker-app build environment)
VITE_API_BASE_URL=https://api.overthinker.example.com
VITE_APP_URL=https://overthinker.example.com
VITE_APP_ENV=production

# Backend (configure only in the backend runtime; never expose these as VITE_* values)
APP_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGODB_DATABASE=overthinker
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-provider-key
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://overthinker.example.com
ALLOWED_ORIGINS=https://overthinker.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
DOCS_ENABLED=false
LOG_LEVEL=INFO
